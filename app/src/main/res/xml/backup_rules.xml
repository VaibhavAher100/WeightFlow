<?xml version="1.0" encoding="utf-8"?>
<!--
    WeightFlow backup rules (API 30 and below).
    All user data is intentionally excluded from cloud backup.
    The app promise is "data stays on your device" — Auto Backup would
    silently upload Room DB and DataStore to Google Drive, breaking that
    promise. Phase 5 will introduce opt-in Firebase cloud sync instead.
-->
<full-backup-content>
    <exclude domain="database" path="weightflow.db" />
    <exclude domain="database" path="weightflow.db-shm" />
    <exclude domain="database" path="weightflow.db-wal" />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="datastore" />
</full-backup-content>