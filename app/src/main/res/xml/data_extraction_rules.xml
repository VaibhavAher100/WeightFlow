<?xml version="1.0" encoding="utf-8"?>
<!--
    WeightFlow data extraction rules (API 31+).
    Cloud backup disabled — user data stays on device.
    Device-to-device transfer enabled until a user-facing export/import
    or Firebase sync ships in Phase 5.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="false">
        <exclude domain="database" path="weightflow.db" />
        <exclude domain="database" path="weightflow.db-shm" />
        <exclude domain="database" path="weightflow.db-wal" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore" />
    </cloud-backup>
</data-extraction-rules>