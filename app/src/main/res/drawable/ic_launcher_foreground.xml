<?xml version="1.0" encoding="utf-8"?>
<!--
  WeightFlow icon — "W" mark as a weight-trend chart line.
  Safe zone: 18–90 on both axes (72dp centred in 108dp canvas).
  Lime (#C8FF00) on warm dark (#0A0907).
  The filled circle at the top-right peak = today's data point.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- W stroke — weight trend chart line -->
    <path
        android:pathData="M22,26 L37,80 L54,50 L71,80 L86,26"
        android:strokeColor="#C8FF00"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"/>

    <!-- Data point dot at top-right peak -->
    <path
        android:pathData="M86,26 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0"
        android:fillColor="#C8FF00"/>

    <!-- Subtle baseline — goal line -->
    <path
        android:pathData="M22,88 L86,88"
        android:strokeColor="#C8FF0033"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

</vector>
